{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "windermereconcrete-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@windermereconcrete.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
